# Normalise line endings: everything in the repo is LF so the shell scripts,
# the Dockerfile and the container entrypoint work on Linux.
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
Dockerfile        text eol=lf
.dockerignore     text eol=lf
.gitignore        text eol=lf
.gitattributes    text eol=lf

# Windows-only helpers (if any) keep CRLF
*.bat   text eol=crlf
*.ps1   text eol=crlf

# binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.skill binary
